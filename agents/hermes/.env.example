# =============================================================================
# Hermes Agent - Singapore ECS (ap-southeast-3)
# =============================================================================
# Copy to ~/.hermes/.env and fill in actual values

# Huawei Cloud ModelArts MaaS API (OpenAI-compatible)
OPENAI_API_KEY=YOUR_MAA_S_API_KEY_HERE
DEEPSEEK_API_KEY=YOUR_MAA_S_API_KEY_HERE

# Huawei Cloud MCP Server (ap-southeast-3)
HW_ACCESS_KEY=YOUR_HUAWEI_CLOUD_AK_HERE
HW_SECRET_KEY=YOUR_HUAWEI_CLOUD_SK_HERE
HW_REGION=ap-southeast-3
HW_PROJECT_ID=YOUR_SINGAPORE_PROJECT_ID_HERE

# GitHub Integration
GITHUB_TOKEN=YOUR_GITHUB_TOKEN_HERE

# Gateway Auth
HERMES_GATEWAY_TOKEN=YOUR_GATEWAY_TOKEN_HERE
