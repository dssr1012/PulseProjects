# =============================================================================
# Hermes Agent Environment Configuration
# =============================================================================
# Copy this file to ~/.hermes/.env and fill in your API keys

# =============================================================================
# LLM PROVIDER (Huawei Cloud ModelArts MaaS - Custom OpenAI-compatible)
# =============================================================================
# Primary provider for Hermes agent
# Base URL: https://api-ap-southeast-1.modelarts-maas.com/openai/v1
# Models: deepseek-v4-flash (primary), deepseek-v3.2, deepseek-v4-pro, glm-5.1, etc.
OPENAI_API_KEY=YOUR_MAA_S_API_KEY_HERE
DEEPSEEK_API_KEY=YOUR_MAA_S_API_KEY_HERE

# =============================================================================
# Huawei Cloud MCP Server
# =============================================================================
HW_ACCESS_KEY=YOUR_HUAWEI_CLOUD_AK_HERE
HW_SECRET_KEY=YOUR_HUAWEI_CLOUD_SK_HERE
HW_REGION=la-south-2
HW_PROJECT_ID=YOUR_PROJECT_ID_HERE

# =============================================================================
# GitHub Integration
# =============================================================================
GITHUB_TOKEN=YOUR_GITHUB_TOKEN_HERE

# =============================================================================
# Telegram Integration (Optional - for Hermes gateway)
# =============================================================================
# Create a NEW bot via @BotFather (different from OpenClaw's bot)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_ALLOWED_USERS=

# =============================================================================
# Gateway Auth
# =============================================================================
HERMES_GATEWAY_TOKEN=YOUR_GATEWAY_TOKEN_HERE
