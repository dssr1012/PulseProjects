# =============================================================================
# Hermes Agent - Singapore ECS (ap-southeast-3)
# =============================================================================
# Copy to ~/.hermes/.env and fill in actual values

# =============================================================================
# LLM Provider (Huawei Cloud ModelArts MaaS - Custom OpenAI-compatible)
# =============================================================================
# IMPORTANT: Hermes with provider:custom uses CUSTOM_API_KEY, not OPENAI_API_KEY
CUSTOM_API_KEY=YOUR_MAA_S_API_KEY_HERE
CUSTOM_BASE_URL=https://api-ap-southeast-1.modelarts-maas.com/openai/v1
# Also set these for compatibility with model name auto-detection
OPENAI_API_KEY=YOUR_MAA_S_API_KEY_HERE
DEEPSEEK_API_KEY=YOUR_MAA_S_API_KEY_HERE

# =============================================================================
# Huawei Cloud MCP Server (ap-southeast-3)
# =============================================================================
HW_ACCESS_KEY=YOUR_HUAWEI_CLOUD_AK_HERE
HW_SECRET_KEY=YOUR_HUAWEI_CLOUD_SK_HERE
HW_REGION=ap-southeast-3
HW_PROJECT_ID=YOUR_SINGAPORE_PROJECT_ID_HERE

# =============================================================================
# GitHub Integration
# =============================================================================
GITHUB_TOKEN=YOUR_GITHUB_TOKEN_HERE

# =============================================================================
# Telegram Integration
# =============================================================================
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_ALLOWED_USERS=YOUR_TELEGRAM_USER_ID_HERE

# =============================================================================
# Gateway Auth
# =============================================================================
HERMES_GATEWAY_TOKEN=YOUR_GATEWAY_TOKEN_HERE
