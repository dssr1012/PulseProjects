# Auto detect text files and perform LF normalization
* text=auto

# Text files
*.md text
*.txt text
*.json text
*.yml text
*.yaml text
*.js text
*.ts text
*.html text
*.css text
*.scss text
*.xml text
*.svg text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.flv binary
*.flac binary
*.m4a binary
*.ogg binary
*.oga binary
*.ogv binary
*.webm binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.tgz binary
*.rar binary
*.7z binary

# Git LFS (if using)
#*.psd filter=lfs diff=lfs merge=lfs -text
#*.ai filter=lfs diff=lfs merge=lfs -text
#*.eps filter=lfs diff=lfs merge=lfs -text
#*.pdf filter=lfs diff=lfs merge=lfs -text

# Shell scripts
*.sh text eol=lf

# Windows batch files
*.bat text eol=crlf

# JSON should always be LF
*.json text eol=lf

# Markdown files
*.md text eol=lf

# Configuration files
*.yml text eol=lf
*.yaml text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf