{
  "// WARNING": "NEVER commit this file to git with real keys!",
  "// INSTRUCTIONS": "1. Copy this file to secrets.json\n2. Replace placeholder values with your actual API keys\n3. Keep secrets.json in .gitignore\n4. Restart OpenClaw gateway",
  
  "gateway": {
    "auth": {
      "token": "YOUR_GATEWAY_AUTH_TOKEN_HERE"
    }
  },
  
  "providers": {
    "custom-api-ap-southeast-1-modelarts-maas-com": {
      "apiKey": "YOUR_MODEL_API_KEY_HERE"
    },
    
    "// ADDITIONAL_PROVIDERS": "Add more providers as needed",
    "openai": {
      "apiKey": "YOUR_OPENAI_API_KEY_HERE"
    },
    
    "anthropic": {
      "apiKey": "YOUR_ANTHROPIC_API_KEY_HERE"
    },
    
    "google": {
      "apiKey": "YOUR_GOOGLE_API_KEY_HERE"
    }
  },
  
  "telegram": {
    "botToken": "YOUR_TELEGRAM_BOT_TOKEN_HERE"
  },
  
  "discord": {
    "botToken": "YOUR_DISCORD_BOT_TOKEN_HERE"
  },
  
  "slack": {
    "botToken": "YOUR_SLACK_BOT_TOKEN_HERE",
    "appToken": "YOUR_SLACK_APP_TOKEN_HERE"
  },
  
  "github": {
    "token": "YOUR_GITHUB_PERSONAL_ACCESS_TOKEN_HERE"
  },
  
  "// OPTIONAL_SECRETS": "Add any other secrets your configuration needs",
  "weather_api": {
    "key": "YOUR_WEATHER_API_KEY_HERE"
  },
  
  "database": {
    "url": "YOUR_DATABASE_CONNECTION_STRING_HERE"
  },
  
  "// ENCRYPTION": "Optional encryption key for sensitive data",
  "encryption": {
    "key": "YOUR_ENCRYPTION_KEY_HERE"
  }
}