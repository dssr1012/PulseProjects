            "contextWindow": 128000,
            "maxTokens": 64000,
            "input": [
              "text"
            ],
            "reasoning": true,
            "cost": {
              "input": 0.27,
              "output": 0.54
            }
          },
          {
            "id": "deepseek-v3.1-terminus",
