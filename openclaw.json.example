              "output": 0.404
            }
          },
          {
            "id": "DeepSeek-V3",
            "name": "DeepSeek-V3 (Custom Provider)",
            "contextWindow": 128000,
            "maxTokens": 32000,
            "input": [
              "text"
            ],
            "reasoning": true,
            "cost": {
              "input": 0.27,
              "output": 0.404
            }
          },
          {
            "id": "deepseek-r1-250528",
            "name": "deepseek-r1-250528 (Custom Provider)",
            "contextWindow": 128000,
            "maxTokens": 32000,
            "input": [
              "text"
            ],
            "reasoning": true,
            "cost": {
              "input": 0.27,
              "output": 0.404
            }
          },
          {
            "id": "glm-5",
            "name": "glm-5 (Custom Provider)",
            "contextWindow": 128000,
            "maxTokens": 32000,
            "input": [
              "text"
            ],
            "reasoning": false,
            "cost": {
