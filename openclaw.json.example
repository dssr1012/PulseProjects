{
  "// IMPORTANT": "This is an example configuration file. Copy to openclaw.json and fill in your secrets.",
  "// SECURITY": "Never commit secrets.json or any file containing actual API keys to git.",
  "// SETUP": "1. Copy this file to openclaw.json\n2. Create secrets.json from secrets.json.example\n3. Fill in your actual API keys\n4. Restart OpenClaw gateway",
  
  "agents": {
    "defaults": {
      "workspace": "/root/.openclaw/workspace",
      "model": {
        "primary": "custom-api-ap-southeast-1-modelarts-maas-com/deepseek-v4-flash",
        "fallbacks": [
          "custom-api-ap-southeast-1-modelarts-maas-com/deepseek-v3.2",
          "custom-api-ap-southeast-1-modelarts-maas-com/deepseek-v4-pro",
          "custom-api-ap-southeast-1-modelarts-maas-com/deepseek-v3.1-terminus",
          "custom-api-ap-southeast-1-modelarts-maas-com/DeepSeek-V3",
          "custom-api-ap-southeast-1-modelarts-maas-com/glm-5.1"
        ]
      },
      "models": {
        "custom-api-ap-southeast-1-modelarts-maas-com/deepseek-v4-flash": {
          "alias": "deepseek-v4-flash"
        },
        "custom-api-ap-southeast-1-modelarts-maas-com/deepseek-v3.2": {
          "alias": "deepseek-v3.2"
        },
        "custom-api-ap-southeast-1-modelarts-maas-com/deepseek-v4-pro": {
          "alias": "deepseek-v4-pro"
        },
        "custom-api-ap-southeast-1-modelarts-maas-com/deepseek-v3.1-terminus": {
          "alias": "deepseek-v3.1-terminus"
        },
        "custom-api-ap-southeast-1-modelarts-maas-com/DeepSeek-V3": {
          "alias": "DeepSeek-V3"
        },
        "custom-api-ap-southeast-1-modelarts-maas-com/deepseek-r1-250528": {
          "alias": "deepseek-r1-250528"
        },
        "custom-api-ap-southeast-1-modelarts-maas-com/glm-5": {
          "alias": "glm-5"
        },
        "custom-api-ap-southeast-1-modelarts-maas-com/glm-5.1": {
          "alias": "glm-5.1"
        }
      },
      "compaction": {
        "reserveTokensFloor": 50000,
        "mode": "safeguard",
        "timeoutSeconds": 300,
        "keepRecentTokens": 10000,
        "identifierPolicy": "strict",
        "midTurnPrecheck": {
          "enabled": true
        },
        "truncateAfterCompaction": true,
        "maxActiveTranscriptBytes": "10mb",
        "notifyUser": false,
        "memoryFlush": {
          "enabled": true,
          "systemPrompt": "Session nearing compaction. Store durable memories now."
        }
      },
      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "1h",
        "keepLastAssistants": 10,
        "softTrimRatio": 0.3,
        "hardClearRatio": 0.5,
        "minPrunableToolChars": 50000,
        "softTrim": {
          "maxChars": 4000,
          "headChars": 1500,
          "tailChars": 1500
        },
        "hardClear": {
          "enabled": true,
          "placeholder": "[Old tool result content cleared]"
        }
      },

    }
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": { "source": "file", "provider": "default", "id": "/gateway/auth/token" }
    },
    "port": 18789,
    "bind": "loopback",
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    },
    "controlUi": {
      "allowInsecureAuth": true
    },
    "nodes": {
      "denyCommands": [
        "camera.snap",
        "camera.clip",
        "screen.record",
        "contacts.add",
        "calendar.add",
        "reminders.add",
        "sms.send",
        "sms.search"
      ]
    }
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "tools": {
    "profile": "coding",
    "web": {
      "search": {
        "provider": "gemini",
        "enabled": true
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "custom-api-ap-southeast-1-modelarts-maas-com": {
        "baseUrl": "https://api-ap-southeast-1.modelarts-maas.com/openai/v1",
        "api": "openai-completions",
        "apiKey": { "source": "file", "provider": "default", "id": "/providers/custom-api-ap-southeast-1-modelarts-maas-com/apiKey" },
        "models": [
          {
            "id": "deepseek-v4-flash",
            "name": "deepseek-v4-flash (Custom Provider)",
            "contextWindow": 1000000,
            "maxTokens": 128000,
            "input": [
              "text"
            ],
            "reasoning": true,
            "cost": {
              "input": 0.135,
              "output": 0.27
            }
          },
          {
            "id": "deepseek-v3.2",
            "name": "deepseek-v3.2 (Custom Provider)",
            "contextWindow": 160000,
            "maxTokens": 32000,
            "input": [
